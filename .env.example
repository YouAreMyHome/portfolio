# EmailJS Configuration
# Đăng ký tại https://www.emailjs.com/ → lấy 3 giá trị dưới đây

# Service ID (Email Services tab)
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx

# Template ID (Email Templates tab)
# Template cần có các variables: {{from_name}}, {{from_email}}, {{message}}, {{to_email}}
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx

# Public Key (Account → API Keys)
VITE_EMAILJS_USER_ID=xxxxxxxxxxxxxxxxxxxxxx

# Cloudinary (Media Library → Dashboard → Cloud Name)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Supabase Configuration (Database & Auth & Storage)
# Tạo dự án miễn phí tại https://supabase.com/ → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Admin fallback passcode (cho phép truy cập Admin khi chưa cấu hình Supabase Auth)
VITE_ADMIN_PASSCODE=admin123
